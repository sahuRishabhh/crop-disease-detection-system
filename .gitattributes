# Auto detect text files and perform LF normalization
* text=auto

# Code and text files - enforce LF line endings
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Windows PowerShell scripts - preserve CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats
*.pt binary
*.pth binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg text
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
