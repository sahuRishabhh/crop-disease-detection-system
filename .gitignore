models/checkpoints/
models/temp/
*.pth
*.ckpt
*.onnx

# Allow baseline compact model and label definitions
!models/mobilenet_v2_crop_disease.pt
!models/class_labels.json
!models/README.md

# --- Evaluation Outputs ---
# Keep baseline verification figures and metrics
!outputs/metrics.json
!outputs/training_history.json
!outputs/confusion_matrix.png
!outputs/training_curves.png
!outputs/README.md

